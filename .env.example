# Shared infra
MYSQL_ROOT_PASSWORD=root
MYSQL_DEFAULT_DB=diwan_users
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Security
# Required, min 32 chars. Shared by all services (verifies JWTs and gateway identity headers).
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
JWT_EXPIRATION_MS=604800000

# Portfolio column encryption key(s): "id:base64(32 random bytes)", required, no default.
# Generate one:  echo "v1:$(openssl rand -base64 32)"
# KEEP A COPY OUTSIDE THE SERVER: losing it makes the encrypted portfolio data unreadable.
# Rotation: put the new key first and keep the old ones, e.g. v2:NEW...,v1:OLD...
DATA_ENCRYPTION_KEYS=v1:CHANGE_ME_BASE64_OF_32_RANDOM_BYTES

# Market data (portfolio): free key from https://finnhub.io; empty = built-in fake prices and news
FINNHUB_API_KEY=

# Optional JPA mode per service
JPA_DDL_AUTO=validate
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=1

# Service-specific DB settings (set before running each service)
# Example for users service
# DB_URL=jdbc:mysql://localhost:3306/diwan_users?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USERNAME=root
# DB_PASSWORD=

# Internal service URLs
USERS_SERVICE_URL=http://localhost:8083

# Smart home Alexa + MQTT
ALEXA_LAMBDA_SHARED_SECRET=CHANGE_ME_ALEXA_SHARED_SECRET
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_PREFIX=diwan-smarthome-
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_QOS=1
MQTT_RETAIN=false

# Container memory limits (docker compose); JVM heap is 70% of the limit
GATEWAY_MEMORY=512m
SERVICE_MEMORY=384m

# Only used with: docker compose --profile observability up -d (Grafana listens on 127.0.0.1 only)
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
