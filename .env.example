# Shared infra
MYSQL_ROOT_PASSWORD=root
MYSQL_DEFAULT_DB=diwan_users
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Security
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
JWT_EXPIRATION_MS=604800000

# Optional JPA mode per service
JPA_DDL_AUTO=update
FLYWAY_ENABLED=false
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=1

# Service-specific DB settings (set before running each service)
# Example for users service
# DB_URL=jdbc:mysql://localhost:3306/diwan_users?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USERNAME=root
# DB_PASSWORD=

# Internal service URLs
USERS_SERVICE_URL=http://localhost:8083

# Smart home Alexa + MQTT
ALEXA_LAMBDA_SHARED_SECRET=CHANGE_ME_ALEXA_SHARED_SECRET
MQTT_BROKER_URL=tcp://broker.hivemq.com:1883
MQTT_CLIENT_PREFIX=diwan-smarthome-
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_QOS=1
MQTT_RETAIN=false